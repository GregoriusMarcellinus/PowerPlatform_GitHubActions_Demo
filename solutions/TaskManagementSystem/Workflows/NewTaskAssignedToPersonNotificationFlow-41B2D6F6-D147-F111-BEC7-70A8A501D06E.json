    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "Task Management Site (tms_TaskManagementSite)": {
          "defaultValue": "https://m365b467805.sharepoint.com/sites/TaskManagement",
          "type": "String",
          "metadata": {
            "schemaName": "tms_TaskManagementSite"
          }
        },
        "Task List (tms_TaskList)": {
          "defaultValue": "2b09fc89-2c29-499b-bca9-cd2d764eaf3a",
          "type": "String",
          "metadata": {
            "schemaName": "tms_TaskList"
          }
        },
        "Task Assigned To Person List (tms_TaskAssignedToPersonList)": {
          "defaultValue": "14f77253-8e43-4f56-9f1e-6e6b0ba1fb23",
          "type": "String",
          "metadata": {
            "schemaName": "tms_TaskAssignedToPersonList"
          }
        },
        "Apps URL (tms_AppsURL)": {
          "defaultValue": "https://teams.microsoft.com/l/entity/644faca5-9752-4903-8a1f-d9ddbf73ff51/644faca5-9752-4903-8a1f-d9ddbf73ff51?context=%7B%22subEntityId%22%3A%22",
          "type": "String",
          "metadata": {
            "schemaName": "tms_AppsURL"
          }
        }
      },
      "triggers": {
        "When_an_item_is_created": {
          "recurrence": {
            "interval": 1,
            "frequency": "Minute"
          },
          "splitOn": "@triggerOutputs()?['body/value']",
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "dataset": "@parameters('Task Management Site (tms_TaskManagementSite)')",
              "table": "@parameters('Task Assigned To Person List (tms_TaskAssignedToPersonList)')"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "operationId": "GetOnNewItems",
              "connectionName": "shared_sharepointonline-1"
            }
          },
          "conditions": [
            {
              "expression": "@and(     not(empty(triggerOutputs()?['body/ID_Task/Value'])),     not(equals(triggerOutputs()?['body/ID_Task/Value'], '')) )"
            }
          ]
        }
      },
      "actions": {
        "Send_an_email_(V2)_-_To_Relevant_User": {
          "runAfter": {
            "Get_item_-_Task_List": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "1fbe8886-2998-41c7-8e89-f36e33de0943"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "emailMessage/To": "@triggerBody()?['ID_User/Value']",
              "emailMessage/Subject": "New Task Assigned: @{concat(\r\n  'TID',\r\n  substring(\r\n    concat('00000', string(outputs('Get_item_-_Task_List')?['body/ID'])),\r\n    sub(length(concat('00000', string(outputs('Get_item_-_Task_List')?['body/ID']))), 5),\r\n    5\r\n  )\r\n)} @{outputs('Get_item_-_Task_List')?['body/task_name']}",
              "emailMessage/Body": "<p class=\"editor-paragraph\">Hi <b>@{triggerBody()?['ID_User/Value']}</b>,<br><br>A new task has been assigned to you: <br><table border=\"0\">\n<tbody>\n<tr><td>Task ID</td><td> : @{concat(\r\n  'TID',\r\n  substring(\r\n    concat('00000', string(outputs('Get_item_-_Task_List')?['body/ID'])),\r\n    sub(length(concat('00000', string(outputs('Get_item_-_Task_List')?['body/ID']))), 5),\r\n    5\r\n  )\r\n)}</td></tr>\n<tr><td>Task Name</td><td> : @{outputs('Get_item_-_Task_List')?['body/task_name']}</td></tr>\n<tr><td>Task Priority</td><td> : @{outputs('Get_item_-_Task_List')?['body/ID_Priority/Value']}</td></tr>\n<tr><td>Task Description</td><td> : @{outputs('Get_item_-_Task_List')?['body/task_description']}</td></tr>\n<tr><td>Plan Start Date</td><td> : @{formatDateTime(\r\n  outputs('Get_item_-_Task_List')?['body/plan_start_date'],\r\n  'dddd, dd MMM yyyy'\r\n)}</td></tr>\n<tr><td>Plan Finish Date</td><td> : @{formatDateTime(\r\n  outputs('Get_item_-_Task_List')?['body/plan_finish_date'],\r\n  'dddd, dd MMM yyyy'\r\n)}</td></tr>\n<tr><td>Assigned By</td><td> : @{outputs('Get_item_-_Task_List')?['body/ID_User_Task_Created_By/Value']}</td></tr>\n</tbody>\n</table><br>Please complete and finalize the assigned task through the link below:<br><a href=\"@{parameters('Apps URL (tms_AppsURL)')}@{outputs('Get_item_-_Task_List')?['body/ID']}%22%7D\" class=\"editor-link\">Open Power Apps</a><br><br>Thank you.</p>",
              "emailMessage/Sensitivity": "defa4170-0d19-0005-0007-bc88714345d2",
              "emailMessage/Importance": "High"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
              "operationId": "SendEmailV2",
              "connectionName": "shared_office365"
            }
          }
        },
        "Post_message_in_a_chat_or_channel_-_To_Relevant_User": {
          "runAfter": {
            "Get_item_-_Task_List": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "poster": "Flow bot",
              "location": "Chat with Flow bot",
              "body/recipient": "@triggerBody()?['ID_User/Value']",
              "body/messageBody": "<p class=\"editor-paragraph\">Hi <b>@{triggerBody()?['ID_User/Value']}</b>,<br><br>A new task has been assigned to you: <br><table border=\"0\">\n<tbody>\n<tr><td>Task ID</td><td> : @{concat(\r\n  'TID',\r\n  substring(\r\n    concat('00000', string(outputs('Get_item_-_Task_List')?['body/ID'])),\r\n    sub(length(concat('00000', string(outputs('Get_item_-_Task_List')?['body/ID']))), 5),\r\n    5\r\n  )\r\n)}</td></tr>\n<tr><td>Task Name</td><td> : @{outputs('Get_item_-_Task_List')?['body/task_name']}</td></tr>\n<tr><td>Task Priority</td><td> : @{outputs('Get_item_-_Task_List')?['body/ID_Priority/Value']}</td></tr>\n<tr><td>Task Description</td><td> : @{outputs('Get_item_-_Task_List')?['body/task_description']}</td></tr>\n<tr><td>Plan Start Date</td><td> : @{formatDateTime(\r\n  outputs('Get_item_-_Task_List')?['body/plan_start_date'],\r\n  'dddd, dd MMM yyyy'\r\n)}</td></tr>\n<tr><td>Plan Finish Date</td><td> : @{formatDateTime(\r\n  outputs('Get_item_-_Task_List')?['body/plan_finish_date'],\r\n  'dddd, dd MMM yyyy'\r\n)}</td></tr>\n<tr><td>Assigned By</td><td> : @{outputs('Get_item_-_Task_List')?['body/ID_User_Task_Created_By/Value']}</td></tr>\n</tbody>\n</table><br>Please complete and finalize the assigned task through the link below:<br><a href=\"@{parameters('Apps URL (tms_AppsURL)')}@{outputs('Get_item_-_Task_List')?['body/ID']}%22%7D\" class=\"editor-link\">Open Power Apps</a><br><br>Thank you.</p>",
              "body/isAlert": true
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams",
              "operationId": "PostMessageToConversation",
              "connectionName": "shared_teams"
            }
          }
        },
        "Get_item_-_Task_List": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "dataset": "@parameters('Task Management Site (tms_TaskManagementSite)')",
              "table": "@parameters('Task List (tms_TaskList)')",
              "id": "@triggerBody()?['ID_Task/Id']"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "operationId": "GetItem",
              "connectionName": "shared_sharepointonline-1"
            }
          }
        }
      }
    },
    "templateName": null
  },
