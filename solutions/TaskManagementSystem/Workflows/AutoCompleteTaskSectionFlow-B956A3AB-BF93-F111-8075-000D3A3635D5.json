{
  "properties": {
    "connectionReferences": {
      "shared_sharepointonline": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "tms_SharePointAdmin"
        },
        "api": {
          "name": "shared_sharepointonline"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "Task Management Site (tms_TaskManagementSite)": {
          "defaultValue": "https://m365b467805.sharepoint.com/sites/TaskManagement",
          "type": "String",
          "metadata": {
            "schemaName": "tms_TaskManagementSite"
          }
        },
        "Task List (tms_TaskList)": {
          "defaultValue": "2b09fc89-2c29-499b-bca9-cd2d764eaf3a",
          "type": "String",
          "metadata": {
            "schemaName": "tms_TaskList"
          }
        }
      },
      "triggers": {
        "manual": {
          "metadata": {
            "operationMetadataId": "7e7f91e2-77c9-4a60-8a86-61cde6dd9a65"
          },
          "type": "Request",
          "kind": "PowerAppV2",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "number": {
                  "description": "Please enter a number",
                  "title": "ID_Task",
                  "type": "number",
                  "x-ms-content-hint": "NUMBER",
                  "x-ms-dynamically-added": true
                }
              },
              "required": [
                "number"
              ]
            }
          }
        }
      },
      "actions": {
        "Get_item_-_Current_Task": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "dataset": "@parameters('Task Management Site (tms_TaskManagementSite)')",
              "table": "@parameters('Task List (tms_TaskList)')",
              "id": "@triggerBody()?['number']"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "operationId": "GetItem",
              "connectionName": "shared_sharepointonline"
            }
          }
        },
        "Respond_to_a_Power_App_or_flow": {
          "runAfter": {
            "Condition_-_Don't_Have_Parent_Task": [
              "Succeeded"
            ]
          },
          "type": "Response",
          "kind": "PowerApp",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "success": {
                  "title": "Success",
                  "type": "boolean",
                  "x-ms-content-hint": "BOOLEAN",
                  "x-ms-dynamically-added": true
                }
              },
              "additionalProperties": {}
            },
            "statusCode": 200,
            "body": {
              "success": true
            }
          }
        },
        "Condition_-_Don't_Have_Parent_Task": {
          "actions": {},
          "runAfter": {
            "Get_item_-_Current_Task": [
              "Succeeded"
            ]
          },
          "else": {
            "actions": {
              "Get_item_-_Parent_Task": {
                "type": "OpenApiConnection",
                "inputs": {
                  "parameters": {
                    "dataset": "@parameters('Task Management Site (tms_TaskManagementSite)')",
                    "table": "@parameters('Task List (tms_TaskList)')",
                    "id": "@outputs('Get_item_-_Current_Task')?['body/ID_Parent_Lookup/Id']"
                  },
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                    "operationId": "GetItem",
                    "connectionName": "shared_sharepointonline"
                  }
                }
              },
              "Condition_-_Parent_Is_Task": {
                "actions": {},
                "runAfter": {
                  "Get_item_-_Parent_Task": [
                    "Succeeded"
                  ]
                },
                "else": {
                  "actions": {
                    "Get_items_-_All_Sibling_Tasks": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "parameters": {
                          "dataset": "@parameters('Task Management Site (tms_TaskManagementSite)')",
                          "table": "@parameters('Task List (tms_TaskList)')",
                          "$filter": "ID_Parent_Lookup/Id eq @{outputs('Get_item_-_Parent_Task')?['body/ID']} and ID_Status/Id ne 5"
                        },
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                          "operationId": "GetItems",
                          "connectionName": "shared_sharepointonline"
                        }
                      }
                    },
                    "Condition_-_All_Tasks_Done": {
                      "actions": {
                        "Update_item_-_Parent_Task_Section_is_Done": {
                          "type": "OpenApiConnection",
                          "inputs": {
                            "parameters": {
                              "dataset": "@parameters('Task Management Site (tms_TaskManagementSite)')",
                              "table": "@parameters('Task List (tms_TaskList)')",
                              "id": "@outputs('Get_item_-_Parent_Task')?['body/ID']",
                              "item/completion_date": "@utcNow()",
                              "item/ID_Status/Id": 5
                            },
                            "host": {
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                              "operationId": "PatchItem",
                              "connectionName": "shared_sharepointonline"
                            }
                          }
                        }
                      },
                      "runAfter": {
                        "Get_items_-_All_Sibling_Tasks": [
                          "Succeeded"
                        ]
                      },
                      "else": {
                        "actions": {}
                      },
                      "expression": {
                        "and": [
                          {
                            "equals": [
                              "@\r\n    length(outputs('Get_items_-_All_Sibling_Tasks')?['body/value'])\r\n",
                              0
                            ]
                          }
                        ]
                      },
                      "type": "If"
                    }
                  }
                },
                "expression": {
                  "and": [
                    {
                      "equals": [
                        "@outputs('Get_item_-_Parent_Task')?['body/is_task']",
                        true
                      ]
                    }
                  ]
                },
                "type": "If"
              }
            }
          },
          "expression": {
            "and": [
              {
                "equals": [
                  "@empty(outputs('Get_item_-_Current_Task')?['body/ID_Parent_Lookup'])",
                  true
                ]
              }
            ]
          },
          "type": "If"
        }
      }
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}