                  "For_each_1": {
                    "foreach": "@outputs('Get_files_(properties_only)_-_Files_in_Folder_-_CEO_Task')?['body/value']",
                    "actions": {
                      "Send_an_HTTP_request_to_SharePoint_-_Reset_All_Files_Permission_-_CEO_Task": {
                        "type": "OpenApiConnection",
                        "inputs": {
                          "parameters": {
                            "dataset": "@parameters('Executive Task Site (tms_ExecutiveTaskSite)')",
                            "parameters/method": "POST",
                            "parameters/uri": "@concat(\r\n'_api/web/GetFolderByServerRelativePath(decodedurl=''/sites/',\r\nreplace(parameters('Site Name for Executive Task Site (tms_SiteNameforExecutiveTaskSite)'), ' ', ''),\r\nitems('For_each_1')?['{FullPath}'],\r\n''')/ListItemAllFields/resetroleinheritance()'\r\n)\r\n\r\n",
                            "parameters/headers": {
                              "Accept": "application/json;odata=verbose",
                              "Content-Type": "application/json;odata=verbose"
                            }
                          },
                          "host": {
                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                            "operationId": "HttpRequest",
                            "connectionName": "shared_sharepointonline-1"
                          }
                        }
                      }
                    },
                    "runAfter": {
                      "Get_files_(properties_only)_-_Files_in_Folder_-_CEO_Task": [
                        "Succeeded"
                      ]
                    },
                    "type": "Foreach",
                    "runtimeConfiguration": {
                      "concurrency": {
                        "repetitions": 5
                      }
                    }
                  }
                }
              },
              "expression": {
                "and": [
                  {
                    "equals": [
                      "@empty(outputs('Get_files_(properties_only)_-_Get_Folder_Name_-_CEO_Task')?['body/value'])",
                      true
                    ]
                  }
                ]
              },
              "type": "If"
            }
          },
          "runAfter": {
            "Get_item_-_User_List": [
              "Succeeded"
            ]
          },
          "else": {
            "actions": {
              "Get_files_(properties_only)_-_Get_Folder_Name": {
                "type": "OpenApiConnection",
                "inputs": {
                  "parameters": {
                    "dataset": "@parameters('Task Management Site (tms_TaskManagementSite)')",
                    "table": "@parameters('Working Y2026 Document Library (tms_WorkingY2026DocumentLibrary)')",
