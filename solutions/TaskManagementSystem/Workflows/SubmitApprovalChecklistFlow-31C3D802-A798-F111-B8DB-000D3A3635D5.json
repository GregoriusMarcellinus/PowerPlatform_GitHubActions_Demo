              },
              "else": {
                "actions": {
                  "Get_files_(properties_only)_-_Files_in_Folder_-_CEO_Task": {
                    "type": "OpenApiConnection",
                    "inputs": {
                      "parameters": {
                        "dataset": "@parameters('Executive Task Site (tms_ExecutiveTaskSite)')",
                        "table": "@parameters('Executive Working Y2026 Document Library (tms_ExecutiveWorkingY2026DocumentLibrary)')",
