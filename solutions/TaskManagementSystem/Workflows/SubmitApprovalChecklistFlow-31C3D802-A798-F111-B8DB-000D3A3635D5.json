                }
              },
              "Condition_-_Doesn't_Have_Folder": {
                "actions": {},
                "runAfter": {
                  "Get_files_(properties_only)_-_Get_Folder_Name": [
                    "Succeeded"
                  ]
                },
                "else": {
                  "actions": {
                    "Get_files_(properties_only)_-_Files_in_Folder": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "parameters": {
                          "dataset": "@parameters('Task Management Site (tms_TaskManagementSite)')",
                          "table": "@parameters('Working Y2026 Document Library (tms_WorkingY2026DocumentLibrary)')",
                          "$filter": "FSObjType eq 0 and ID_Checklist eq @{triggerBody()?['number_1']}",
                          "folderPath": "@{parameters('Document Library Name for Working (tms_DocumentLibraryNameforWorking)')}/@{first(outputs('Get_files_(properties_only)_-_Get_Folder_Name')?['body/value'])?['{Name}']}"
                        },
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                          "operationId": "GetFileItems",
                          "connectionName": "shared_sharepointonline-1"
                        }
                      }
                    },
                    "For_each_2": {
                      "foreach": "@outputs('Get_files_(properties_only)_-_Files_in_Folder')?['body/value']",
                      "actions": {
                        "Send_an_HTTP_request_to_SharePoint_-_Reset_All_Files_Permission": {
                          "type": "OpenApiConnection",
                          "inputs": {
                            "parameters": {
                              "dataset": "@parameters('Task Management Site (tms_TaskManagementSite)')",
                              "parameters/method": "POST",
                              "parameters/uri": "@concat(\r\n'_api/web/GetFileByServerRelativePath(decodedurl=''/sites/',\r\nreplace(parameters('Site Name for Task Management Site (tms_SiteNameforTaskManagementSite)'), ' ', ''),\r\nitems('For_each_2')?['{FullPath}'],\r\n''')/ListItemAllFields/resetroleinheritance()'\r\n)",
                              "parameters/headers": {
                                "Accept": "application/json;odata=verbose",
                                "Content-Type": "application/json;odata=verbose"
                              }
                            },
                            "host": {
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                              "operationId": "HttpRequest",
                              "connectionName": "shared_sharepointonline-1"
                            }
                          }
                        }
                      },
                      "runAfter": {
                        "Get_files_(properties_only)_-_Files_in_Folder": [
                          "Succeeded"
                        ]
                      },
                      "type": "Foreach",
                      "runtimeConfiguration": {
                        "concurrency": {
                          "repetitions": 5
                        }
                      }
                    }
                  }
                },
                "expression": {
                  "and": [
                    {
                      "equals": [
                        "@empty(outputs('Get_files_(properties_only)_-_Get_Folder_Name')?['body/value'])",
                        true
                      ]
                    }
                  ]
                },
                "type": "If"
              }
            }
          },
          "expression": {
            "and": [
              {
                "equals": [
                  "@int(outputs('Get_item_-_User_List')?['body/ID_Role_x003a__x0020_role_level/Value'])",
                  4
                ]
              }
            ]
          },
          "type": "If"
        },
        "Get_item_-_User_List": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "dataset": "@parameters('Task Management Site (tms_TaskManagementSite)')",
              "table": "@parameters('User List (tms_UserList)')",
              "id": "@triggerBody()?['number_3']"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "operationId": "GetItem",
              "connectionName": "shared_sharepointonline-1"
            }
          }
