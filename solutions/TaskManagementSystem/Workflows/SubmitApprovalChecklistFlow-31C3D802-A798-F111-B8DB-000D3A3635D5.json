        "Apply_to_each_-_Related_Users": {
          "foreach": "@union(\r\n    body('Select'),\r\n    createArray(\r\n        json(\r\n            concat(\r\n                '{\"email\":\"',\r\n                triggerBody()?['email'],\r\n                '\"}'\r\n            )\r\n        )\r\n    )\r\n)",
          "actions": {
            "Post_message_in_a_chat_or_channel": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "poster": "Flow bot",
                  "location": "Chat with Flow bot",
                  "body/recipient": "@item()?['email']",
                  "body/messageBody": "<p class=\"editor-paragraph\">\nHi <b>@{item()?['email']}</b>,<br><br>\n\nA checklist has been marked as finished by an assignee and is now pending your approval @{concat(\n  'TID',\n  substring(\n    concat('00000', string(triggerBody()?['number'])),\n    sub(length(concat('00000', string(triggerBody()?['number']))), 5),\n    5\n  )\n)} @{triggerBody()?['text_2']}:<br>\n\n<table border=\"0\">\n<tbody>\n<tr>\n<td>Checklist</td>\n<td> : @{outputs('Update_item_-_Checklist')?['body/checklist_name']}</td>\n</tr>\n<tr>\n<td>Finished By</td>\n<td> : @{outputs('Update_item_-_Checklist')?['body/ID_User_Finished_By/Value']}</td>\n</tr>\n<tr>\n<td>At</td>\n<td> : @{formatDateTime(\n    convertTimeZone(\n        outputs('Update_item_-_Checklist')?['body/finished_at'],\n        'UTC',\n        'SE Asia Standard Time'\n    ),\n    'dd MMM yyyy HH:mm'\n)}</td>\n</tr>\n</tbody>\n</table>\n\n<br>\nPlease review the completed checklist and approve or reject it in Power Apps using the link below:<br>\n\n<a href=\"@{parameters('Apps URL (tms_AppsURL)')}@{triggerBody()?['number']}%22%7D\" class=\"editor-link\">\nOpen Power Apps\n</a>\n\n<br><br>\nThank you.\n</p>",
                  "body/isAlert": true
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams",
                  "operationId": "PostMessageToConversation",
                  "connectionName": "shared_teams"
                }
              }
            },
            "Send_an_email_(V2)": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "emailMessage/To": "@item()?['email']",
                  "emailMessage/Subject": "Checklist Finished, Requires Approval @{concat(\r\n  'TID',\r\n  substring(\r\n    concat('00000', string(triggerBody()?['number'])),\r\n    sub(length(concat('00000', string(triggerBody()?['number']))), 5),\r\n    5\r\n  )\r\n)} @{triggerBody()?['text_2']}",
                  "emailMessage/Body": "<p class=\"editor-paragraph\">\nHi <b>@{item()?['email']}</b>,<br><br>\n\nA checklist has been marked as finished by an assignee and is now pending your approval @{concat(\n  'TID',\n  substring(\n    concat('00000', string(triggerBody()?['number'])),\n    sub(length(concat('00000', string(triggerBody()?['number']))), 5),\n    5\n  )\n)} @{triggerBody()?['text_2']}:<br>\n\n<table border=\"0\">\n<tbody>\n<tr>\n<td>Checklist</td>\n<td> : @{outputs('Update_item_-_Checklist')?['body/checklist_name']}</td>\n</tr>\n<tr>\n<td>Finished By</td>\n<td> : @{outputs('Update_item_-_Checklist')?['body/ID_User_Finished_By/Value']}</td>\n</tr>\n<tr>\n<td>At</td>\n<td> : @{formatDateTime(\r\n    convertTimeZone(\r\n        outputs('Update_item_-_Checklist')?['body/finished_at'],\r\n        'UTC',\r\n        'SE Asia Standard Time'\r\n    ),\r\n    'dd MMM yyyy HH:mm'\r\n)}</td>\n</tr>\n</tbody>\n</table>\n\n<br>\nPlease review the completed checklist and approve or reject it in Power Apps using the link below:<br>\n\n<a href=\"@{parameters('Apps URL (tms_AppsURL)')}@{triggerBody()?['number']}%22%7D\" class=\"editor-link\">\nOpen Power Apps\n</a>\n\n<br><br>\nThank you.\n</p>",
                  "emailMessage/Importance": "High"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                  "operationId": "SendEmailV2",
                  "connectionName": "shared_office365"
                }
              }
            }
          },
          "runAfter": {
            "Select": [
              "Succeeded"
            ],
            "Update_item_-_Checklist": [
              "Succeeded"
            ]
          },
          "type": "Foreach"
