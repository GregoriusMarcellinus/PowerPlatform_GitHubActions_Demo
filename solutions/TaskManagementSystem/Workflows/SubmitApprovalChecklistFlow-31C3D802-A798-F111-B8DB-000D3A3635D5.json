        "Condition_-_Is_CEO_Task": {
          "actions": {
            "Get_files_(properties_only)_-_Get_Folder_Name_-_CEO_Task": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "dataset": "@parameters('Executive Task Site (tms_ExecutiveTaskSite)')",
