      "triggers": {
        "manual": {
          "metadata": {
            "operationMetadataId": "49d761b2-2a8f-46f0-9eae-110f3b53ca99"
          },
          "type": "Request",
          "kind": "PowerAppV2",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "number": {
                  "description": "Please enter a number",
                  "title": "ID_Task",
                  "type": "number",
                  "x-ms-content-hint": "NUMBER",
                  "x-ms-dynamically-added": true
                },
                "text": {
                  "description": "Please enter your input",
                  "title": "Checklist_Name",
                  "type": "string",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                },
                "number_1": {
                  "description": "Please enter a number",
                  "title": "ChecklistCreatedById",
                  "type": "number",
                  "x-ms-content-hint": "NUMBER",
                  "x-ms-dynamically-added": true
                },
                "text_1": {
                  "description": "Please enter your input",
                  "title": "Checklist_Status",
                  "type": "string",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                },
                "text_2": {
                  "description": "Please enter your input",
                  "title": "Task_Name",
                  "type": "string",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                },
                "email": {
                  "description": "Enter an email address.",
                  "format": "email",
                  "title": "Task_Assigner",
                  "type": "string",
                  "x-ms-content-hint": "EMAIL",
                  "x-ms-dynamically-added": true
                }
              },
              "required": [
                "number",
                "text",
                "number_1",
                "text_1",
                "text_2",
                "email"
              ]
            }
          }
        }
      },
      "actions": {
        "Create_item_-_Checklist": {
          "runAfter": {},
          "metadata": {
            "operationMetadataId": "459edc8d-0695-4868-8258-fb7dec090083"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "dataset": "@parameters('Task Management Site (tms_TaskManagementSite)')",
              "table": "@parameters('Checklist List (tms_ChecklistList)')",
              "item/ID_Task/Id": "@triggerBody()?['number']",
              "item/checklist_name": "@triggerBody()?['text']",
              "item/ID_User_Checklist_Created_By/Id": "@triggerBody()?['number_1']",
              "item/checklist_status": "@triggerBody()?['text_1']"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "operationId": "PostItem",
              "connectionName": "shared_sharepointonline-1"
            }
          }
        },
        "Respond_to_a_Power_App_or_flow": {
          "runAfter": {
            "Compose_-_Checklist_Response": [
              "Succeeded"
            ]
          },
          "type": "Response",
          "kind": "PowerApp",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "success": {
                  "title": "Success",
                  "type": "boolean",
                  "x-ms-content-hint": "BOOLEAN",
                  "x-ms-dynamically-added": true
                },
                "checklist": {
                  "title": "Checklist",
                  "type": "string",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                }
              },
              "additionalProperties": {}
            },
            "statusCode": 200,
            "body": {
              "success": true,
              "checklist": "@{outputs('Compose_-_Checklist_Response')}"
            }
          }
        },
        "Switch_-_Checklist_Status": {
          "runAfter": {
            "Create_item_-_Checklist": [
              "Succeeded"
            ],
            "Select_2": [
              "Succeeded"
            ],
            "Select_1": [
              "Succeeded"
            ]
          },
          "cases": {
            "Case_-_Draft_-_Send_to_Assigner": {
              "case": "Draft",
              "actions": {
                "Post_message_in_a_chat_or_channel_1": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "parameters": {
                      "poster": "Flow bot",
                      "location": "Chat with Flow bot",
                      "body/recipient": "@triggerBody()?['email']",
                      "body/messageBody": "<p class=\"editor-paragraph\">\nHi <b>@{triggerBody()?['email']}</b>,<br><br>\n\nA new checklist has been proposed for your task @{concat(\n  'TID',\n  substring(\n    concat('00000', string(triggerBody()?['number'])),\n    sub(length(concat('00000', string(triggerBody()?['number']))), 5),\n    5\n  )\n)} @{triggerBody()?['text_2']} by an assignee and requires your approval:<br>\n\n<table border=\"0\">\n<tbody>\n<tr>\n<td>Checklist</td>\n<td> : @{outputs('Create_item_-_Checklist')?['body/checklist_name']}</td>\n</tr>\n<tr>\n<td>Proposed By</td>\n<td> : @{outputs('Create_item_-_Checklist')?['body/ID_User_Checklist_Created_By/Value']}</td>\n</tr>\n<tr>\n<td>At</td>\n<td> : @{formatDateTime(\n    convertTimeZone(\n        outputs('Create_item_-_Checklist')?['body/Created'],\n        'UTC',\n        'SE Asia Standard Time'\n    ),\n    'dd MMM yyyy HH:mm'\n)}</td>\n</tr>\n</tbody>\n</table>\n\n<br>\nPlease review and approve or reject the proposed checklist in Power Apps using the link below:<br>\n\n<a href=\"@{parameters('Apps URL (tms_AppsURL)')}@{triggerBody()?['number']}%22%7D\" class=\"editor-link\">\nOpen Power Apps\n</a>\n\n<br><br>\nThank you.\n</p>",
                      "body/isAlert": true
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams",
                      "operationId": "PostMessageToConversation",
                      "connectionName": "shared_teams"
                    }
                  }
                },
                "Send_an_email_(V2)_1": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "parameters": {
                      "emailMessage/To": "@triggerBody()?['email']",
                      "emailMessage/Subject": "A new checklist has been proposed for your task @{concat(\n  'TID',\n  substring(\n    concat('00000', string(triggerBody()?['number'])),\n    sub(length(concat('00000', string(triggerBody()?['number']))), 5),\n    5\n  )\n)} @{triggerBody()?['text_2']}",
                      "emailMessage/Body": "<p class=\"editor-paragraph\">\nHi <b>@{triggerBody()?['email']}</b>,<br><br>\n\nA new checklist has been proposed for your task @{concat(\n  'TID',\n  substring(\n    concat('00000', string(triggerBody()?['number'])),\n    sub(length(concat('00000', string(triggerBody()?['number']))), 5),\n    5\n  )\n)} @{triggerBody()?['text_2']} by an assignee and requires your approval:<br>\n\n<table border=\"0\">\n<tbody>\n<tr>\n<td>Checklist</td>\n<td> : @{outputs('Create_item_-_Checklist')?['body/checklist_name']}</td>\n</tr>\n<tr>\n<td>Proposed By</td>\n<td> : @{outputs('Create_item_-_Checklist')?['body/ID_User_Checklist_Created_By/Value']}</td>\n</tr>\n<tr>\n<td>At</td>\n<td> : @{formatDateTime(\n    convertTimeZone(\n        outputs('Create_item_-_Checklist')?['body/Created'],\n        'UTC',\n        'SE Asia Standard Time'\n    ),\n    'dd MMM yyyy HH:mm'\n)}</td>\n</tr>\n</tbody>\n</table>\n\n<br>\nPlease review and approve or reject the proposed checklist in Power Apps using the link below:<br>\n\n<a href=\"@{parameters('Apps URL (tms_AppsURL)')}@{triggerBody()?['number']}%22%7D\" class=\"editor-link\">\nOpen Power Apps\n</a>\n\n<br><br>\nThank you.\n</p>",
                      "emailMessage/Importance": "High"
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                      "operationId": "SendEmailV2",
                      "connectionName": "shared_office365"
                    }
                  }
                }
              }
            },
            "Case_-_New_-_Send_to_All_Assignees": {
              "case": "New",
              "actions": {
                "Apply_to_each_-_Related_Users": {
                  "foreach": "@union(body('Select_1'), body('Select_2'))",
                  "actions": {
                    "Post_message_in_a_chat_or_channel": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "parameters": {
                          "poster": "Flow bot",
                          "location": "Chat with Flow bot",
                          "body/recipient": "@item()?['email']",
                          "body/messageBody": "<p class=\"editor-paragraph\">\nHi <b>@{item()?['email']}</b>,<br><br>\n\nA new checklist has been added to your task @{concat(\n  'TID',\n  substring(\n    concat('00000', string(triggerBody()?['number'])),\n    sub(length(concat('00000', string(triggerBody()?['number']))), 5),\n    5\n  )\n)} @{triggerBody()?['text_2']}:<br>\n\n<table border=\"0\">\n<tbody>\n<tr>\n<td>Checklist</td>\n<td> : @{outputs('Create_item_-_Checklist')?['body/checklist_name']}</td>\n</tr>\n<tr>\n<td>Added By</td>\n<td> : @{outputs('Create_item_-_Checklist')?['body/ID_User_Checklist_Created_By/Value']}</td>\n</tr>\n<tr>\n<td>At</td>\n<td> : @{formatDateTime(\n    convertTimeZone(\n        outputs('Create_item_-_Checklist')?['body/Created'],\n        'UTC',\n        'SE Asia Standard Time'\n    ),\n    'dd MMM yyyy HH:mm'\n)}</td>\n</tr>\n</tbody>\n</table>\n\n<br>\nPlease review and complete the new checklist in Power Apps using the link below:<br>\n\n<a href=\"@{parameters('Apps URL (tms_AppsURL)')}@{triggerBody()?['number']}%22%7D\" class=\"editor-link\">\nOpen Power Apps\n</a>\n\n<br><br>\nThank you.\n</p>",
                          "body/isAlert": true
                        },
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams",
                          "operationId": "PostMessageToConversation",
                          "connectionName": "shared_teams"
                        }
                      }
                    },
                    "Send_an_email_(V2)": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "parameters": {
                          "emailMessage/To": "@item()?['email']",
                          "emailMessage/Subject": "New Checklist Added to Your Task @{concat(\n  'TID',\n  substring(\n    concat('00000', string(triggerBody()?['number'])),\n    sub(length(concat('00000', string(triggerBody()?['number']))), 5),\n    5\n  )\n)} @{triggerBody()?['text_2']}",
                          "emailMessage/Body": "<p class=\"editor-paragraph\">\nHi <b>@{item()?['email']}</b>,<br><br>\n\nA new checklist has been added to your task @{concat(\n  'TID',\n  substring(\n    concat('00000', string(triggerBody()?['number'])),\n    sub(length(concat('00000', string(triggerBody()?['number']))), 5),\n    5\n  )\n)} @{triggerBody()?['text_2']}:<br>\n\n<table border=\"0\">\n<tbody>\n<tr>\n<td>Checklist</td>\n<td> : @{outputs('Create_item_-_Checklist')?['body/checklist_name']}</td>\n</tr>\n<tr>\n<td>Added By</td>\n<td> : @{outputs('Create_item_-_Checklist')?['body/ID_User_Checklist_Created_By/Value']}</td>\n</tr>\n<tr>\n<td>At</td>\n<td> : @{formatDateTime(\n    convertTimeZone(\n        outputs('Create_item_-_Checklist')?['body/Created'],\n        'UTC',\n        'SE Asia Standard Time'\n    ),\n    'dd MMM yyyy HH:mm'\n)}</td>\n</tr>\n</tbody>\n</table>\n\n<br>\nPlease review and complete the new checklist in Power Apps using the link below:<br>\n\n<a href=\"@{parameters('Apps URL (tms_AppsURL)')}@{triggerBody()?['number']}%22%7D\" class=\"editor-link\">\nOpen Power Apps\n</a>\n\n<br><br>\nThank you.\n</p>",
                          "emailMessage/Importance": "High"
                        },
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                          "operationId": "SendEmailV2",
                          "connectionName": "shared_office365"
                        }
                      }
                    }
                  },
                  "type": "Foreach"
                }
              }
            }
          },
          "default": {
            "actions": {}
          },
          "expression": "@triggerBody()?['text_1']",
          "type": "Switch"
        },
        "Get_items_-_Assign_To_Person_List": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "dataset": "@parameters('Task Management Site (tms_TaskManagementSite)')",
              "table": "@parameters('Task Assigned To Person List (tms_TaskAssignedToPersonList)')",
              "$filter": "ID_Task/Id eq @{triggerBody()?['number']}"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "operationId": "GetItems",
              "connectionName": "shared_sharepointonline-1"
            }
          }
        },
        "Get_items_-_Assign_To_Division_List": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "dataset": "@parameters('Task Management Site (tms_TaskManagementSite)')",
              "table": "@parameters('Task Assigned To Division List (tms_TaskAssignedToDivisionList)')",
              "$filter": "ID_Task/Id eq @{triggerBody()?['number']}"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "operationId": "GetItems",
              "connectionName": "shared_sharepointonline-1"
            }
          }
        },
        "Select_2": {
          "runAfter": {
            "Get_items_-_Assign_To_Person_List": [
              "Succeeded"
            ]
          },
          "type": "Select",
          "inputs": {
            "from": "@outputs('Get_items_-_Assign_To_Person_List')?['body/value']",
            "select": {
              "email": "@item()?['ID_User/Value']"
            }
          }
        },
        "Condition_-_No_Division_Assigned": {
          "actions": {},
          "runAfter": {
            "Get_items_-_Assign_To_Division_List": [
              "Succeeded"
            ]
          },
          "else": {
            "actions": {
              "Select_-_Division": {
                "type": "Select",
                "inputs": {
                  "from": "@outputs('Get_items_-_Assign_To_Division_List')?['body/value']",
                  "select": {
                    "ID_Division/Id eq": "@item()?['ID_Division/Id']"
                  }
                }
              },
              "Join_-_or": {
                "runAfter": {
                  "Select_-_Division": [
                    "Succeeded"
                  ]
                },
                "type": "Join",
                "inputs": {
                  "from": "@body('Select_-_Division')",
                  "joinWith": " or "
                }
              },
              "Get_items_-_All_Users_in_All_Divisions": {
                "runAfter": {
                  "Join_-_or": [
                    "Succeeded"
                  ]
                },
                "type": "OpenApiConnection",
                "inputs": {
                  "parameters": {
                    "dataset": "@parameters('Task Management Site (tms_TaskManagementSite)')",
                    "table": "@parameters('User List (tms_UserList)')",
                    "$filter": "@replace(\r\n    replace(\r\n        replace(\r\n            replace(body('Join_-_or'), '{', ''),\r\n        '}', ''),\r\n    '\"', ''),\r\n':', ' '\r\n)"
                  },
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                    "operationId": "GetItems",
                    "connectionName": "shared_sharepointonline-1"
                  }
                }
              }
            }
          },
          "expression": {
            "and": [
              {
                "equals": [
                  "@empty(outputs('Get_items_-_Assign_To_Division_List')?['body/value'])",
                  true
                ]
              }
            ]
          },
          "type": "If"
        },
        "Select_1": {
          "runAfter": {
            "Condition_-_No_Division_Assigned": [
              "Succeeded"
            ]
          },
          "type": "Select",
          "inputs": {
            "from": "@\r\n\r\ncoalesce(\r\noutputs('Get_items_-_All_Users_in_All_Divisions')?['body/value'],\r\n   json('[]')\r\n)",
            "select": {
              "email": "@item()?['email']"
            }
          }
        },
        "Compose_-_Checklist_Response": {
          "runAfter": {
            "Create_item_-_Checklist": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": {
            "ID": "@{outputs('Create_item_-_Checklist')?['body/ID']}",
            "checklist_name": "@{outputs('Create_item_-_Checklist')?['body/checklist_name']}",
            "ID_User_Checklist_Created_By": "@{outputs('Create_item_-_Checklist')?['body/ID_User_Checklist_Created_By']}",
            "ID_Task": "@{outputs('Create_item_-_Checklist')?['body/ID_Task']}",
            "Created": "@{outputs('Create_item_-_Checklist')?['body/Created']}",
            "Modified": "@{outputs('Create_item_-_Checklist')?['body/Modified']}",
            "checklist_status": "@{outputs('Create_item_-_Checklist')?['body/checklist_status']}",
            "approved_at": "@{outputs('Create_item_-_Checklist')?['body/approved_at']}",
            "ID_User_Approver": "@{outputs('Create_item_-_Checklist')?['body/ID_User_Approver']}",
            "ID_User_Finished_By": "@{outputs('Create_item_-_Checklist')?['body/ID_User_Finished_By']}",
            "finished_at": "@{outputs('Create_item_-_Checklist')?['body/finished_at']}"
          }
        }
      }
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}