        "Send_an_email_(V2)_-_To_Task_Creator": {
          "runAfter": {
            "Update_item_-_Task": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "1fbe8886-2998-41c7-8e89-f36e33de0943"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "emailMessage/To": "@outputs('Update_item_-_Task')?['body/ID_User_Task_Created_By/Value']",
              "emailMessage/Subject": "@{concat(\r\n  'TID',\r\n  substring(\r\n    concat('00000', string(outputs('Update_item_-_Task')?['body/ID'])),\r\n    sub(length(concat('00000', string(outputs('Update_item_-_Task')?['body/ID']))), 5),\r\n    5\r\n  )\r\n)}  @{outputs('Update_item_-_Task')?['body/task_name']} is Now IN PROGRESS",
              "emailMessage/Body": "<p class=\"editor-paragraph\">Hi <b>@{outputs('Update_item_-_Task')?['body/ID_User_Task_Created_By/Value']}</b>,<br><br>Your task is now <b>IN PROGRESS</b>.<br><table border=\"0\">\n<tbody>\n<tr><td>Task ID</td><td> : @{concat(\r\n  'TID',\r\n  substring(\r\n    concat('00000', string(outputs('Update_item_-_Task')?['body/ID'])),\r\n    sub(length(concat('00000', string(outputs('Update_item_-_Task')?['body/ID']))), 5),\r\n    5\r\n  )\r\n)}</td></tr>\n<tr><td>Task Name</td><td> : @{outputs('Update_item_-_Task')?['body/task_name']}</td></tr>\n<tr><td>Task Priority</td><td> : @{outputs('Update_item_-_Task')?['body/ID_Priority/Value']}</td></tr>\n<tr><td>Task Description</td><td> : @{outputs('Update_item_-_Task')?['body/task_description']}</td></tr>\n<tr><td>Task Status</td><td> : @{outputs('Update_item_-_Task')?['body/ID_Status/Value']}</td></tr>\n<tr><td>Plan Start Date</td><td> : @{formatDateTime(outputs('Update_item_-_Task')?['body/plan_start_date'], 'dddd, dd MMM yyyy')}</td></tr>\n<tr><td>Actual Start Date</td><td> : @{formatDateTime(outputs('Update_item_-_Task')?['body/actual_start_date'], 'dddd, dd MMM yyyy')}</td></tr>\n<tr><td>Plan Finish Date</td><td> : @{formatDateTime(outputs('Update_item_-_Task')?['body/plan_finish_date'], 'dddd, dd MMM yyyy')}</td></tr>\n<tr><td>Task Started By</td><td> : @{outputs('Update_item_-_Task')?['body/ID_User_Task_Created_By/Value']}</td></tr>\n</tbody>\n</table><br>The task has officially been picked up and is currently being worked on by <b>@{outputs('Update_item_-_Task')?['body/ID_User_Task_Started_By/Value']}</b><br><br>You can monitor the progress through the link below:<br><a href=\"https://apps.powerapps.com/play/e/default-ba21f1d3-cac5-4fff-ba59-3d4a1bd8bffa/a/a767a055-f110-4ebd-b49f-9c3ffd157688?tenantId=ba21f1d3-cac5-4fff-ba59-3d4a1bd8bffa&amp;hint=b66f0ca6-3e60-4b0c-8ab9-d02dc13a736d&amp;source=sharebutton&amp;sourcetime=1776076575777&amp;ID_Task=@{outputs('Update_item_-_Task')?['body/ID']}\" class=\"editor-link\">Open Power Apps</a><br><br>Thank you.</p>",
              "emailMessage/Sensitivity": "defa4170-0d19-0005-0007-bc88714345d2",
              "emailMessage/Importance": "High"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
              "operationId": "SendEmailV2",
              "connectionName": "shared_office365"
            }
          }
        },
        "Post_message_in_a_chat_or_channel_-_To_Task_Creator": {
          "runAfter": {
            "Update_item_-_Task": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "poster": "Flow bot",
              "location": "Chat with Flow bot",
              "body/recipient": "@outputs('Update_item_-_Task')?['body/ID_User_Task_Created_By/Value']",
              "body/messageBody": "<p class=\"editor-paragraph\">Hi <b>@{outputs('Update_item_-_Task')?['body/ID_User_Task_Created_By/Value']}</b>,<br><br>Your task is now <b>IN PROGRESS</b>.<br><table border=\"0\">\n<tbody>\n<tr><td>Task ID</td><td> : @{concat(\n  'TID',\n  substring(\n    concat('00000', string(outputs('Update_item_-_Task')?['body/ID'])),\n    sub(length(concat('00000', string(outputs('Update_item_-_Task')?['body/ID']))), 5),\n    5\n  )\n)}</td></tr>\n<tr><td>Task Name</td><td> : @{outputs('Update_item_-_Task')?['body/task_name']}</td></tr>\n<tr><td>Task Priority</td><td> : @{outputs('Update_item_-_Task')?['body/ID_Priority/Value']}</td></tr>\n<tr><td>Task Description</td><td> : @{outputs('Update_item_-_Task')?['body/task_description']}</td></tr>\n<tr><td>Task Status</td><td> : @{outputs('Update_item_-_Task')?['body/ID_Status/Value']}</td></tr>\n<tr><td>Plan Start Date</td><td> : @{formatDateTime(outputs('Update_item_-_Task')?['body/plan_start_date'], 'dddd, dd MMM yyyy')}</td></tr>\n<tr><td>Actual Start Date</td><td> : @{formatDateTime(outputs('Update_item_-_Task')?['body/actual_start_date'], 'dddd, dd MMM yyyy')}</td></tr>\n<tr><td>Plan Finish Date</td><td> : @{formatDateTime(outputs('Update_item_-_Task')?['body/plan_finish_date'], 'dddd, dd MMM yyyy')}</td></tr>\n<tr><td>Task Started By</td><td> : @{outputs('Update_item_-_Task')?['body/ID_User_Task_Created_By/Value']}</td></tr>\n</tbody>\n</table><br>The task has officially been picked up and is currently being worked on by <b>@{outputs('Update_item_-_Task')?['body/ID_User_Task_Started_By/Value']}</b><br><br>You can monitor the progress through the link below:<br><a href=\"https://apps.powerapps.com/play/e/default-ba21f1d3-cac5-4fff-ba59-3d4a1bd8bffa/a/a767a055-f110-4ebd-b49f-9c3ffd157688?tenantId=ba21f1d3-cac5-4fff-ba59-3d4a1bd8bffa&amp;hint=b66f0ca6-3e60-4b0c-8ab9-d02dc13a736d&amp;source=sharebutton&amp;sourcetime=1776076575777&amp;ID_Task=@{outputs('Update_item_-_Task')?['body/ID']}\" class=\"editor-link\">Open Power Apps</a><br><br>Thank you.</p>",
              "body/isAlert": true
