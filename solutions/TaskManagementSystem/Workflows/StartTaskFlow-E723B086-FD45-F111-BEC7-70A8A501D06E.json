            "ID_Priority": "@{outputs('Update_item_-_Task')?['body/ID_Priority']}",
            "task_description": "@{outputs('Update_item_-_Task')?['body/task_description']}",
            "plan_start_date": "@{outputs('Update_item_-_Task')?['body/plan_start_date']}",
            "plan_finish_date": "@{outputs('Update_item_-_Task')?['body/plan_finish_date']}",
            "is_task": "@outputs('Update_item_-_Task')?['body/is_task']",
            "ID_Status": "@{outputs('Update_item_-_Task')?['body/ID_Status']}",
            "ID_User_Task_Created_By": "@{outputs('Update_item_-_Task')?['body/ID_User_Task_Created_By']}",
            "Created": "@{outputs('Update_item_-_Task')?['body/Created']}",
            "actual_start_date": "@{outputs('Update_item_-_Task')?['body/actual_start_date']}",
