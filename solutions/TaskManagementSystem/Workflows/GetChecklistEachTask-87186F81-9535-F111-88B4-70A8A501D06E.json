    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "Task Management Site (tms_TaskManagementSite)": {
          "defaultValue": "https://m365b467805.sharepoint.com/sites/TaskManagement",
          "type": "String",
          "metadata": {
            "schemaName": "tms_TaskManagementSite"
          }
        },
        "Checklist List (tms_ChecklistList)": {
          "defaultValue": "c0d32f4f-d4e8-43b9-8445-0ecd9b904004",
          "type": "String",
          "metadata": {
            "schemaName": "tms_ChecklistList"
          }
        }
      },
      "triggers": {
        "manual": {
          "metadata": {
            "operationMetadataId": "ae14d66e-468b-45d1-b9e8-aeadf593cefb"
          },
          "type": "Request",
          "kind": "PowerAppV2",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "number": {
                  "title": "ID_Task",
                  "type": "number",
                  "x-ms-dynamically-added": true,
                  "description": "Please enter a number",
                  "x-ms-content-hint": "NUMBER"
                }
              },
              "required": [
                "number"
              ]
            }
          }
        }
      },
      "actions": {
        "Get_items_-_Checklist_Lists": {
          "runAfter": {},
          "metadata": {
            "operationMetadataId": "3e935faa-c71b-4b68-8714-16ad6e4125ba"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "dataset": "@parameters('Task Management Site (tms_TaskManagementSite)')",
              "table": "@parameters('Checklist List (tms_ChecklistList)')",
              "$filter": "ID_Task eq @{triggerBody()?['number']}"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "operationId": "GetItems",
              "connectionName": "shared_sharepointonline-1"
            }
          }
        },
        "Respond_to_a_Power_App_or_flow": {
          "runAfter": {
            "Select": [
              "Succeeded"
            ]
          },
          "type": "Response",
          "kind": "PowerApp",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "value": {
                  "title": "Value",
                  "type": "string",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                }
              },
              "additionalProperties": {}
            },
            "statusCode": 200,
            "body": {
              "value": "@{string(body('Select'))}"
            }
          }
        },
        "Select": {
          "runAfter": {
            "Get_items_-_Checklist_Lists": [
              "Succeeded"
            ]
          },
          "type": "Select",
          "inputs": {
            "from": "@outputs('Get_items_-_Checklist_Lists')?['body/value']",
            "select": {
              "ID": "@item()?['ID']",
              "checklist_name": "@item()?['checklist_name']",
              "ID_User_Checklist_Created_By": "@item()?['ID_User_Checklist_Created_By']",
              "ID_Task": "@item()?['ID_Task']",
              "Created": "@item()?['Created']",
              "Modified": "@item()?['Modified']",
              "checklist_status": "@item()?['checklist_status']",
              "approved_at": "@item()?['approved_at']",
              "ID_User_Approver": "@item()?['ID_User_Approver']",
              "ID_User_Finished_By": "@item()?['ID_User_Finished_By']",
              "finished_at": "@item()?['finished_at']"
            }
          }
        }
      }
    },
    "templateName": null
