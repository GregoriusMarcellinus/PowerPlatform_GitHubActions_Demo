{
  "properties": {
    "connectionReferences": {
      "shared_sharepointonline-1": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "tms_SharePointAdmin"
        },
        "api": {
          "name": "shared_sharepointonline"
        }
      },
      "shared_office365": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "tms_sharedoffice365_d642d"
        },
        "api": {
          "name": "shared_office365"
        }
      },
      "shared_teams": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "tms_sharedteams_7e1c0"
        },
        "api": {
          "name": "shared_teams"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "Task Management Site (tms_TaskManagementSite)": {
          "defaultValue": "https://m365x42752428.sharepoint.com/sites/TaskManagement",
          "type": "String",
          "metadata": {
            "schemaName": "tms_TaskManagementSite"
          }
        },
        "Task List (tms_TaskList)": {
          "defaultValue": "9d03fe54-d65f-49ec-ad9c-e620fcdf5e97",
          "type": "String",
          "metadata": {
            "schemaName": "tms_TaskList"
          }
        },
        "Approval List (tms_ApprovalList)": {
          "defaultValue": "ee7f3171-17ba-4193-961f-a6e15471fce6",
          "type": "String",
          "metadata": {
            "schemaName": "tms_ApprovalList"
          }
        },
        "Task Assigned To Division List (tms_TaskAssignedToDivisionList)": {
          "defaultValue": "e7028b4c-d650-4a6c-bdfb-95e0bce9dac3",
          "type": "String",
          "metadata": {
            "schemaName": "tms_TaskAssignedToDivisionList"
          }
        },
        "Task Assigned To Person List (tms_TaskAssignedToPersonList)": {
          "defaultValue": "4d9c5a75-c12d-4ab3-8798-65a521af0151",
          "type": "String",
          "metadata": {
            "schemaName": "tms_TaskAssignedToPersonList"
          }
        },
        "User List (tms_UserList)": {
          "defaultValue": "af959190-09d5-44f7-8f35-9404d4407c70",
          "type": "String",
          "metadata": {
            "schemaName": "tms_UserList"
          }
        },
        "Apps URL (tms_AppsURL)": {
          "defaultValue": "https://apps.powerapps.com/play/e/default-fc332174-6326-4458-9aa0-843b51894465/a/24b00176-2675-4def-b0bd-ec6aef1c5c8f",
          "type": "String",
          "metadata": {
            "schemaName": "tms_AppsURL"
          }
        }
      },
      "triggers": {
        "manual": {
          "metadata": {
            "operationMetadataId": "e9355ff9-c248-44e8-b0bd-657770f44fcb"
          },
          "type": "Request",
          "kind": "PowerAppV2",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "number": {
                  "description": "Please enter a number",
                  "title": "ID_Task",
                  "type": "number",
                  "x-ms-content-hint": "NUMBER",
                  "x-ms-dynamically-added": true
                }
              },
              "required": [
                "number"
              ]
            }
          }
        }
      },
      "actions": {
        "Respond_to_a_Power_App_or_flow": {
          "runAfter": {
            "For_each_2_Assignees": [
              "Succeeded"
            ],
            "For_each_1_1_Assignees": [
              "Succeeded"
            ]
          },
          "type": "Response",
          "kind": "PowerApp",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "success": {
                  "title": "Success",
                  "type": "boolean",
                  "x-ms-content-hint": "BOOLEAN",
                  "x-ms-dynamically-added": true
                }
              },
              "additionalProperties": {}
            },
            "statusCode": 200,
            "body": {
              "success": true
            }
          }
        },
        "Get_items_-_Approval_List": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "dataset": "@parameters('Task Management Site (tms_TaskManagementSite)')",
              "table": "@parameters('Approval List (tms_ApprovalList)')",
              "$filter": "ID_Task/Id eq @{triggerBody()?['number']}"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "operationId": "GetItems",
              "connectionName": "shared_sharepointonline-1"
            }
          }
        },
        "Update_item_-_Task_List_is_IN_PROGRESS_": {
          "runAfter": {
            "For_each": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "dataset": "@parameters('Task Management Site (tms_TaskManagementSite)')",
              "table": "@parameters('Task List (tms_TaskList)')",
              "id": "@triggerBody()?['number']",
              "item/completion_date": "@null",
              "item/ID_Status/Id": 3
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "operationId": "PatchItem",
              "connectionName": "shared_sharepointonline-1"
            }
          }
        },
        "For_each": {
          "foreach": "@outputs('Get_items_-_Approval_List')?['body/value']",
          "actions": {
            "Delete_item_-_Approval_List": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "dataset": "@parameters('Task Management Site (tms_TaskManagementSite)')",
                  "table": "@parameters('Approval List (tms_ApprovalList)')",
                  "id": "@items('For_each')?['ID']"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "operationId": "DeleteItem",
                  "connectionName": "shared_sharepointonline-1"
                }
              }
            }
          },
          "runAfter": {
            "Get_items_-_Approval_List": [
              "Succeeded"
            ]
          },
          "type": "Foreach"
        },
        "Get_items_-_Assign_To_Person_List": {
          "runAfter": {
            "Update_item_-_Task_List_is_IN_PROGRESS_": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "dataset": "@parameters('Task Management Site (tms_TaskManagementSite)')",
              "table": "@parameters('Task Assigned To Person List (tms_TaskAssignedToPersonList)')",
              "$filter": "ID_Task/Id eq @{outputs('Update_item_-_Task_List_is_IN_PROGRESS_')?['body/ID']}"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "operationId": "GetItems",
              "connectionName": "shared_sharepointonline-1"
            }
          }
        },
        "Get_items_-_Assign_To_Division_List": {
          "runAfter": {
            "Update_item_-_Task_List_is_IN_PROGRESS_": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "dataset": "@parameters('Task Management Site (tms_TaskManagementSite)')",
              "table": "@parameters('Task Assigned To Division List (tms_TaskAssignedToDivisionList)')",
              "$filter": "ID_Task/Id eq @{outputs('Update_item_-_Task_List_is_IN_PROGRESS_')?['body/ID']}"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "operationId": "GetItems",
              "connectionName": "shared_sharepointonline-1"
            }
          }
        },
        "Condition_-_No_Division_Assigned": {
          "actions": {},
          "runAfter": {
            "Get_items_-_Assign_To_Division_List": [
              "Succeeded"
            ]
          },
          "else": {
            "actions": {
              "Select_-_Division": {
                "type": "Select",
                "inputs": {
                  "from": "@outputs('Get_items_-_Assign_To_Division_List')?['body/value']",
                  "select": {
                    "ID_Division/Id eq": "@item()?['ID_Division/Id']"
                  }
                }
              },
              "Join_-_or": {
                "runAfter": {
                  "Select_-_Division": [
                    "Succeeded"
                  ]
                },
                "type": "Join",
                "inputs": {
                  "from": "@body('Select_-_Division')",
                  "joinWith": " or "
                }
              },
              "Get_items_-_All_Users_in_All_Divisions": {
                "runAfter": {
                  "Join_-_or": [
                    "Succeeded"
                  ]
                },
                "type": "OpenApiConnection",
                "inputs": {
                  "parameters": {
                    "dataset": "@parameters('Task Management Site (tms_TaskManagementSite)')",
                    "table": "@parameters('User List (tms_UserList)')",
                    "$filter": "@replace(\r\n    replace(\r\n        replace(\r\n            replace(body('Join_-_or'), '{', ''),\r\n        '}', ''),\r\n    '\"', ''),\r\n':', ' '\r\n)"
                  },
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                    "operationId": "GetItems",
                    "connectionName": "shared_sharepointonline-1"
                  }
                }
              }
            }
          },
          "expression": {
            "and": [
              {
                "equals": [
                  "@empty(outputs('Get_items_-_Assign_To_Division_List')?['body/value'])",
                  true
                ]
              }
            ]
          },
          "type": "If"
        },
        "Select_2": {
          "runAfter": {
            "Get_items_-_Assign_To_Person_List": [
              "Succeeded"
            ]
          },
          "type": "Select",
          "inputs": {
            "from": "@outputs('Get_items_-_Assign_To_Person_List')?['body/value']",
            "select": {
              "email": "@item()?['ID_User/Value']"
            }
          }
        },
        "Select_1": {
          "runAfter": {
            "Condition_-_No_Division_Assigned": [
              "Succeeded"
            ]
          },
          "type": "Select",
          "inputs": {
            "from": "@coalesce(\r\noutputs('Get_items_-_All_Users_in_All_Divisions')?['body/value'],\r\n   json('[]')\r\n)",
            "select": {
              "email": "@item()?['email']"
            }
          }
        },
        "For_each_2_Assignees": {
          "foreach": "@union(body('Select_1'), body('Select_2'))",
          "actions": {
            "Send_an_email_(V2)_-_To_Related_User_1": {
              "metadata": {
                "operationMetadataId": "1fbe8886-2998-41c7-8e89-f36e33de0943"
              },
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "emailMessage/To": "@item()?['email']",
                  "emailMessage/Subject": "@{concat(\r\n  'TID',\r\n  substring(\r\n    concat('00000', string(\r\n      outputs('Update_item_-_Task_List_is_IN_PROGRESS_')?['body/ID']\r\n    )),\r\n    sub(length(concat('00000', string(outputs('Update_item_-_Task_List_is_IN_PROGRESS_')?['body/ID']\r\n      \r\n    ))), 5),\r\n    5\r\n  )\r\n)} @{outputs('Update_item_-_Task_List_is_IN_PROGRESS_')?['body/task_name']} Has Been Returned for Revision and Marked as IN PROGRESS",
                  "emailMessage/Body": "<p class=\"editor-paragraph\">Hi <b>@{item()?['email']}</b>,<br><br>Your task has been returned for revision by the approver. The task status has been updated from WARNING to <b>IN PROGRESS</b>. <br><table border=\"0\">\n<tbody>\n<tr><td>Task ID</td><td> : @{concat(\r\n  'TID',\r\n  substring(\r\n    concat('00000', string(outputs('Update_item_-_Task_List_is_IN_PROGRESS_')?['body/ID']\r\n      \r\n    )),\r\n    sub(length(concat('00000', string(outputs('Update_item_-_Task_List_is_IN_PROGRESS_')?['body/ID']\r\n      \r\n    ))), 5),\r\n    5\r\n  )\r\n)}</td></tr>\n<tr><td>Task Name</td><td> : @{outputs('Update_item_-_Task_List_is_IN_PROGRESS_')?['body/task_name']}</td></tr>\n<tr><td>Task Priority</td><td> : @{outputs('Update_item_-_Task_List_is_IN_PROGRESS_')?['body/ID_Priority/Value']}</td></tr>\n<tr><td>Task Description</td><td> : @{outputs('Update_item_-_Task_List_is_IN_PROGRESS_')?['body/task_description']}</td></tr>\n<tr><td>Plan Start Date</td><td> : @{formatDateTime(\r\noutputs('Update_item_-_Task_List_is_IN_PROGRESS_')?['body/plan_start_date'],\r\n  'dddd, dd MMM yyyy'\r\n)\r\n\r\n}</td></tr>\n<tr><td>Actual Start Date</td><td> : @{formatDateTime(\r\noutputs('Update_item_-_Task_List_is_IN_PROGRESS_')?['body/actual_start_date'],\r\n  'dddd, dd MMM yyyy'\r\n)}</td></tr>\n<tr><td>Plan Finish Date</td><td> : @{formatDateTime(\r\noutputs('Update_item_-_Task_List_is_IN_PROGRESS_')?['body/plan_finish_date'],\r\n  'dddd, dd MMM yyyy'\r\n)}</td></tr>\n</tbody>\n</table><br>Please review and update the task accordingly, and resubmit it for approval once the required changes have been completed. You can review the task details through the link below:<br><a href=\"@{parameters('Apps URL (tms_AppsURL)')}&amp;ID_Task=@{outputs('Update_item_-_Task_List_is_IN_PROGRESS_')?['body/ID']}\" class=\"editor-link\">Open Power Apps</a><br><br>Thank you.</p>",
                  "emailMessage/Sensitivity": "defa4170-0d19-0005-0007-bc88714345d2",
                  "emailMessage/Importance": "High"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                  "operationId": "SendEmailV2",
                  "connectionName": "shared_office365"
                }
              }
            }
          },
          "runAfter": {
            "Select_2": [
              "Succeeded"
            ],
            "Select_1": [
              "Succeeded"
            ]
          },
          "type": "Foreach",
          "runtimeConfiguration": {
            "concurrency": {
              "repetitions": 5
            }
          }
        },
        "For_each_1_1_Assignees": {
          "foreach": "@union(body('Select_1'), body('Select_2'))",
          "actions": {
            "Post_message_in_a_chat_or_channel_-_To_Related_User_1": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "poster": "Flow bot",
                  "location": "Chat with Flow bot",
                  "body/recipient": "@item()?['email']",
                  "body/messageBody": "<p class=\"editor-paragraph\">Hi <b>@{item()?['email']}</b>,<br><br>Your task has been returned for revision by the approver. The task status has been updated from WARNING to <b>IN PROGRESS</b>. <br><table border=\"0\">\n<tbody>\n<tr><td>Task ID</td><td> : @{concat(\n  'TID',\n  substring(\n    concat('00000', string(outputs('Update_item_-_Task_List_is_IN_PROGRESS_')?['body/ID']\n      \n    )),\n    sub(length(concat('00000', string(outputs('Update_item_-_Task_List_is_IN_PROGRESS_')?['body/ID']\n      \n    ))), 5),\n    5\n  )\n)}</td></tr>\n<tr><td>Task Name</td><td> : @{outputs('Update_item_-_Task_List_is_IN_PROGRESS_')?['body/task_name']}</td></tr>\n<tr><td>Task Priority</td><td> : @{outputs('Update_item_-_Task_List_is_IN_PROGRESS_')?['body/ID_Priority/Value']}</td></tr>\n<tr><td>Task Description</td><td> : @{outputs('Update_item_-_Task_List_is_IN_PROGRESS_')?['body/task_description']}</td></tr>\n<tr><td>Plan Start Date</td><td> : @{formatDateTime(\noutputs('Update_item_-_Task_List_is_IN_PROGRESS_')?['body/plan_start_date'],\n  'dddd, dd MMM yyyy'\n)\n\n}</td></tr>\n<tr><td>Actual Start Date</td><td> : @{formatDateTime(\noutputs('Update_item_-_Task_List_is_IN_PROGRESS_')?['body/actual_start_date'],\n  'dddd, dd MMM yyyy'\n)}</td></tr>\n<tr><td>Plan Finish Date</td><td> : @{formatDateTime(\noutputs('Update_item_-_Task_List_is_IN_PROGRESS_')?['body/plan_finish_date'],\n  'dddd, dd MMM yyyy'\n)}</td></tr>\n</tbody>\n</table><br>Please review and update the task accordingly, and resubmit it for approval once the required changes have been completed. You can review the task details through the link below:<br><a href=\"@{parameters('Apps URL (tms_AppsURL)')}&amp;ID_Task=@{outputs('Update_item_-_Task_List_is_IN_PROGRESS_')?['body/ID']}\" class=\"editor-link\">Open Power Apps</a><br><br>Thank you.</p>",
                  "body/isAlert": true
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams",
                  "operationId": "PostMessageToConversation",
                  "connectionName": "shared_teams"
                }
              }
            }
          },
          "runAfter": {
            "Select_1": [
              "Succeeded"
            ],
            "Select_2": [
              "Succeeded"
            ]
          },
          "type": "Foreach",
          "runtimeConfiguration": {
            "concurrency": {
              "repetitions": 5
            }
          }
        }
      }
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}