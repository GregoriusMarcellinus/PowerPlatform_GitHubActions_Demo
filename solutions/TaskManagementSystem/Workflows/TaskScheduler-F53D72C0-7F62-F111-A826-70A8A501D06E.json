          "recurrence": {
            "frequency": "Day",
            "interval": 1,
            "startTime": "2026-06-06T17:00:00Z",
            "timeZone": "SE Asia Standard Time",
            "schedule": {
              "hours": [
                "7"
              ],
              "minutes": [
                0
              ]
            }
          },
          "metadata": {
            "operationMetadataId": "81bec574-f439-47f3-a347-47bfb59b38ad"
          },
          "type": "Recurrence"
        }
      },
      "actions": {
        "Get_items": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "dataset": "@parameters('Task Management Site (tms_TaskManagementSite)')",
              "table": "@parameters('Task Scheduler List (tms_TaskSchedulerList)')",
              "$filter": "is_active eq 1 and next_running le '@{utcNow('yyyy-MM-dd')}'"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "operationId": "GetItems",
              "connectionName": "shared_sharepointonline-1"
            }
          }
        },
        "Apply_to_each": {
          "foreach": "@outputs('Get_items')?['body/value']",
          "actions": {
            "Get_items_-_All_Assigned_Division": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "dataset": "@parameters('Task Management Site (tms_TaskManagementSite)')",
                  "table": "@parameters('Task Assigned To Division List (tms_TaskAssignedToDivisionList)')",
                  "$filter": "ID_Task_Scheduler eq @{items('Apply_to_each')?['ID']}"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "operationId": "GetItems",
                  "connectionName": "shared_sharepointonline-1"
                }
              }
            },
            "Get_items_-_All_Assigned_Person": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "dataset": "@parameters('Task Management Site (tms_TaskManagementSite)')",
                  "table": "@parameters('Task Assigned To Person List (tms_TaskAssignedToPersonList)')",
                  "$filter": "ID_Task_Scheduler eq @{items('Apply_to_each')?['ID']}"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "operationId": "GetItems",
                  "connectionName": "shared_sharepointonline-1"
                }
              }
            },
            "Create_item_-_Task_List": {
              "runAfter": {
                "Condition_-_Do_Not_Have_Parent": [
                  "Succeeded"
                ]
              },
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "dataset": "@parameters('Task Management Site (tms_TaskManagementSite)')",
                  "table": "@parameters('Task List (tms_TaskList)')",
                  "item/ID_Parent_Lookup/Id": "@items('Apply_to_each')?['ID_Parent_Lookup/Id']",
                  "item/ID_Parent_Number": "@items('Apply_to_each')?['ID_Parent_Lookup/Id']",
                  "item/ID_GrandParent_Lookup/Id": "@items('Apply_to_each')?['ID_GrandParent_Lookup/Id']",
                  "item/ID_GrandParent_Number": "@items('Apply_to_each')?['ID_GrandParent_Lookup/Id']",
                  "item/task_level": "@add(\n    int(coalesce(outputs('Get_item_-_Parent_Task')?['body/task_level'], 0)),\n    1\n)",
                  "item/is_task": true,
                  "item/task_name": "@concat(\n    items('Apply_to_each')?['task_name'],\n    if(\n        or(\n            equals(items('Apply_to_each')?['use_month_suffix'], true),\n            equals(items('Apply_to_each')?['use_year_suffix'], true)\n        ),\n        concat(\n            ' - ',\n            if(\n                equals(items('Apply_to_each')?['use_month_suffix'], true),\n                formatDateTime(utcNow(), 'MMM'),\n                ''\n            ),\n            if(\n                and(\n                    equals(items('Apply_to_each')?['use_month_suffix'], true),\n                    equals(items('Apply_to_each')?['use_year_suffix'], true)\n                ),\n                ' ',\n                ''\n            ),\n            if(\n                equals(items('Apply_to_each')?['use_year_suffix'], true),\n                formatDateTime(utcNow(), 'yyyy'),\n                ''\n            )\n        ),\n        ''\n    )\n)",
                  "item/task_description": "<p class=\"editor-paragraph\">@{items('Apply_to_each')?['task_description']}</p>",
                  "item/ID_Priority/Id": "@items('Apply_to_each')?['ID_Priority/Id']",
                  "item/plan_start_date": "@items('Apply_to_each')?['next_running']",
                  "item/plan_finish_date": "@addDays(\r\n    items('Apply_to_each')?['next_running'],\r\n    int(items('Apply_to_each')?['estimated_duration']),\r\n    'yyyy-MM-dd'\r\n)",
                  "item/ID_Status/Id": 1,
                  "item/ID_User_Task_Created_By/Id": "@items('Apply_to_each')?['ID_User_TS_Created_By/Id']",
                  "item/ID_Task_Scheduler/Id": "@items('Apply_to_each')?['ID']",
                  "item/reminder_date": "@if(\n    equals(items('Apply_to_each')?['reminder_before'], null),\n    null,\n    addDays(\n        addDays(\n            items('Apply_to_each')?['next_running'],\n            int(items('Apply_to_each')?['estimated_duration'])\n        ),\n        sub(0, int(items('Apply_to_each')?['reminder_before'])),\n        'yyyy-MM-dd'\n    )\n)",
                  "item/task_duration": "@int(items('Apply_to_each')?['estimated_duration'])"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "operationId": "PostItem",
                  "connectionName": "shared_sharepointonline-1"
                }
              }
            },
            "For_each": {
              "foreach": "@outputs('Get_items_-_All_Assigned_Division')?['body/value']",
              "actions": {
                "Create_item_-_Task_Assigned_to_Division_List": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "parameters": {
                      "dataset": "@parameters('Task Management Site (tms_TaskManagementSite)')",
                      "table": "@parameters('Task Assigned To Division List (tms_TaskAssignedToDivisionList)')",
                      "item/ID_Division/Id": "@items('For_each')?['ID_Division/Id']",
                      "item/ID_Task/Id": "@outputs('Create_item_-_Task_List')?['body/ID']"
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                      "operationId": "PostItem",
                      "connectionName": "shared_sharepointonline-1"
                    }
                  }
                }
              },
              "runAfter": {
                "Get_items_-_All_Assigned_Division": [
                  "Succeeded"
                ],
                "Create_item_-_Task_List": [
                  "Succeeded"
                ]
              },
              "type": "Foreach",
              "runtimeConfiguration": {
                "concurrency": {
                  "repetitions": 5
                }
              }
            },
            "For_each_1": {
              "foreach": "@outputs('Get_items_-_All_Assigned_Person')?['body/value']",
              "actions": {
                "Create_item_-_Task_Assigned_to_Person_List": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "parameters": {
                      "dataset": "@parameters('Task Management Site (tms_TaskManagementSite)')",
                      "table": "@parameters('Task Assigned To Person List (tms_TaskAssignedToPersonList)')",
                      "item/ID_User/Id": "@items('For_each_1')?['ID_User/Id']",
                      "item/ID_Task/Id": "@outputs('Create_item_-_Task_List')?['body/ID']"
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                      "operationId": "PostItem",
                      "connectionName": "shared_sharepointonline-1"
                    }
                  }
                }
              },
              "runAfter": {
                "Get_items_-_All_Assigned_Person": [
                  "Succeeded"
                ],
                "Create_item_-_Task_List": [
                  "Succeeded"
                ]
              },
              "type": "Foreach"
            },
            "Get_item_-_Frequency_List": {
              "runAfter": {
                "For_each": [
                  "Succeeded"
                ],
                "For_each_1": [
                  "Succeeded"
                ],
                "Condition_-_Is_CEO_Task": [
                  "Succeeded"
                ]
              },
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "dataset": "@parameters('Task Management Site (tms_TaskManagementSite)')",
                  "table": "@parameters('Frequency List (tms_FrequencyList)')",
                  "id": "@items('Apply_to_each')?['ID_Frequency/Id']"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "operationId": "GetItem",
                  "connectionName": "shared_sharepointonline-1"
                }
              }
            },
            "Compose_-_Next_Running": {
              "runAfter": {
                "Get_item_-_Frequency_List": [
                  "Succeeded"
                ]
              },
              "type": "Compose",
              "inputs": "@if(\r\n    equals(\r\n        toLower(outputs('Get_item_-_Frequency_List')?['body/unit']),\r\n        'day'\r\n    ),\r\n    addDays(\r\n        items('Apply_to_each')?['next_running'],\r\n        int(outputs('Get_item_-_Frequency_List')?['body/interval'])\r\n    ),\r\n    if(\r\n        equals(\r\n            toLower(outputs('Get_item_-_Frequency_List')?['body/unit']),\r\n            'week'\r\n        ),\r\n        addDays(\r\n            items('Apply_to_each')?['next_running'],\r\n            mul(\r\n                int(outputs('Get_item_-_Frequency_List')?['body/interval']),\r\n                7\r\n            )\r\n        ),\r\n        if(\r\n            equals(\r\n                toLower(outputs('Get_item_-_Frequency_List')?['body/unit']),\r\n                'month'\r\n            ),\r\n            addToTime(\r\n                items('Apply_to_each')?['next_running'],\r\n                int(outputs('Get_item_-_Frequency_List')?['body/interval']),\r\n                'Month'\r\n            ),\r\n            addToTime(\r\n                items('Apply_to_each')?['next_running'],\r\n                int(outputs('Get_item_-_Frequency_List')?['body/interval']),\r\n                'Year'\r\n            )\r\n        )\r\n    )\r\n)"
            },
            "Condition": {
              "actions": {
                "Update_item_-_Still_Active": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "parameters": {
                      "dataset": "@parameters('Task Management Site (tms_TaskManagementSite)')",
                      "table": "@parameters('Task Scheduler List (tms_TaskSchedulerList)')",
                      "id": "@items('Apply_to_each')?['ID']",
                      "item/start_scheduler": "@items('Apply_to_each')?['start_scheduler']",
                      "item/end_scheduler": "@items('Apply_to_each')?['end_scheduler']",
                      "item/is_active": true,
                      "item/last_running": "@items('Apply_to_each')?['next_running']",
                      "item/next_running": "@outputs('Compose_-_Next_Running')"
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                      "operationId": "PatchItem",
                      "connectionName": "shared_sharepointonline-1"
                    }
                  }
                }
              },
              "runAfter": {
                "Compose_-_Next_Running": [
                  "Succeeded"
                ]
              },
              "else": {
                "actions": {
                  "Update_item_-_Not_Active": {
                    "type": "OpenApiConnection",
                    "inputs": {
                      "parameters": {
                        "dataset": "@parameters('Task Management Site (tms_TaskManagementSite)')",
                        "table": "@parameters('Task Scheduler List (tms_TaskSchedulerList)')",
                        "id": "@items('Apply_to_each')?['ID']",
                        "item/start_scheduler": "@items('Apply_to_each')?['start_scheduler']",
                        "item/end_scheduler": "@items('Apply_to_each')?['end_scheduler']",
                        "item/is_active": false,
                        "item/last_running": "@items('Apply_to_each')?['next_running']",
                        "item/next_running": "@null"
                      },
                      "host": {
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                        "operationId": "PatchItem",
                        "connectionName": "shared_sharepointonline-1"
                      }
                    }
                  }
                }
              },
              "expression": {
                "and": [
                  {
                    "lessOrEquals": [
                      "@outputs('Compose_-_Next_Running')",
                      "@items('Apply_to_each')?['end_scheduler']"
                    ]
                  }
                ]
              },
              "type": "If"
            },
            "Condition_-_Do_Not_Have_Parent": {
              "actions": {},
              "else": {
                "actions": {
                  "Get_item_-_Parent_Task": {
                    "type": "OpenApiConnection",
                    "inputs": {
                      "parameters": {
                        "dataset": "@parameters('Task Management Site (tms_TaskManagementSite)')",
                        "table": "@parameters('Task List (tms_TaskList)')",
                        "id": "@items('Apply_to_each')?['ID_Parent_Lookup/Id']"
                      },
                      "host": {
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                        "operationId": "GetItem",
                        "connectionName": "shared_sharepointonline-1"
                      }
                    }
                  }
                }
              },
              "expression": {
                "and": [
                  {
                    "equals": [
                      "@\r\nequals(\r\n    items('Apply_to_each')?['ID_Parent_Lookup/Id'],\r\n    null\r\n)\r\n\r\n",
                      true
                    ]
                  }
                ]
              },
              "type": "If"
            },
            "Get_item_-_User_List": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "dataset": "@parameters('Task Management Site (tms_TaskManagementSite)')",
                  "table": "@parameters('User List (tms_UserList)')",
                  "id": "@items('Apply_to_each')?['ID_User_TS_Created_By/Id']"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "operationId": "GetItem",
                  "connectionName": "shared_sharepointonline-1"
                }
              }
            },
            "Condition_-_Is_CEO_Task": {
              "actions": {
                "Condition_-_Is_Empty_-_CEO_Task": {
                  "actions": {},
                  "runAfter": {
                    "Get_files_(properties_only)_-_Get_Folder_Name_-_CEO_Task": [
                      "Succeeded"
                    ]
                  },
                  "else": {
                    "actions": {
                      "Update_file_properties_-_ID_Task_Lookup_Column_-_CEO_Task": {
                        "runAfter": {
                          "Send_an_HTTP_request_to_SharePoint_-_CEO_Task": [
                            "Succeeded"
                          ]
                        },
                        "type": "OpenApiConnection",
                        "inputs": {
                          "parameters": {
                            "dataset": "@parameters('Executive Task Site (tms_ExecutiveTaskSite)')",
                            "table": "@parameters('Executive Working Y2026 Document Library (tms_ExecutiveWorkingY2026DocumentLibrary)')",
                            "id": "@outputs('Copy_folder_-_From_Task_Scheduler_Reference_to_Working_-_CEO_Task')?['body/ItemId']",
                            "item/ID_Task": "@outputs('Create_item_-_Task_List')?['body/ID']",
                            "item/task_root_number": "@outputs('Create_item_-_Task_List')?['body/ID_GrandParent_Lookup/Id']",
                            "item/task_level": "@outputs('Create_item_-_Task_List')?['body/task_level']",
                            "item/ID_Task_Scheduler": "@items('Apply_to_each')?['ID']"
                          },
                          "host": {
                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                            "operationId": "PatchFileItem",
                            "connectionName": "shared_sharepointonline-1"
                          }
                        }
                      },
                      "Copy_folder_-_From_Task_Scheduler_Reference_to_Working_-_CEO_Task": {
                        "type": "OpenApiConnection",
                        "inputs": {
                          "parameters": {
                            "dataset": "@parameters('Executive Task Site (tms_ExecutiveTaskSite)')",
                            "parameters/sourceFolderId": "@first(outputs('Get_files_(properties_only)_-_Get_Folder_Name_-_CEO_Task')?['body/value'])?['{Identifier}']",
                            "parameters/destinationDataset": "@parameters('Executive Task Site (tms_ExecutiveTaskSite)')",
                            "parameters/destinationFolderPath": "@parameters('Document Library Name for Executive Working (tms_DocumentLibraryNameforExecutiveWorking)')",
                            "parameters/nameConflictBehavior": 1
                          },
                          "host": {
                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                            "operationId": "CopyFolderAsync",
                            "connectionName": "shared_sharepointonline-1"
                          }
                        }
                      },
                      "Send_an_HTTP_request_to_SharePoint_-_CEO_Task": {
                        "runAfter": {
                          "Copy_folder_-_From_Task_Scheduler_Reference_to_Working_-_CEO_Task": [
                            "Succeeded"
                          ]
                        },
                        "type": "OpenApiConnection",
                        "inputs": {
                          "parameters": {
                            "dataset": "@parameters('Executive Task Site (tms_ExecutiveTaskSite)')",
                            "parameters/method": "POST",
                            "parameters/uri": "_api/web/lists/GetbyTitle('@{parameters('Document Library Name for Executive Working (tms_DocumentLibraryNameforExecutiveWorking)')}')/items(@{outputs('Copy_folder_-_From_Task_Scheduler_Reference_to_Working_-_CEO_Task')?['body/ItemId']})/validateUpdateListItem",
                            "parameters/body": "{\n  \"formValues\": [\n    {\n      \"FieldName\": \"FileLeafRef\",\n      \"FieldValue\": \"@{concat(\r\n    toUpper(formatDateTime(utcNow(),'ddMMMyyyy')),\r\n    '_TS',\r\n    substring(\r\n        concat('00000', string(items('Apply_to_each')?['ID'])),\r\n        sub(length(concat('00000', string(items('Apply_to_each')?['ID']))), 5),\r\n        5\r\n    ),\r\n        '_T',\r\n    substring(\r\n        concat('00000', string(outputs('Create_item_-_Task_List')?['body/ID'])),\r\n        sub(length(concat('00000', string(outputs('Create_item_-_Task_List')?['body/ID']))), 5),\r\n        5\r\n    ),\r\n    '_',\r\n    outputs('Create_item_-_Task_List')?['body/task_name']\r\n)}\"\n    }\n  ]\n}"
                          },
                          "host": {
                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                            "operationId": "HttpRequest",
                            "connectionName": "shared_sharepointonline-1"
                          }
                        }
                      },
                      "Get_files_(properties_only)_-_All_Files_in_Folder_-_CEO_Task": {
                        "runAfter": {
                          "Update_file_properties_-_ID_Task_Lookup_Column_-_CEO_Task": [
                            "Succeeded"
                          ]
                        },
                        "type": "OpenApiConnection",
                        "inputs": {
                          "parameters": {
                            "dataset": "@parameters('Executive Task Site (tms_ExecutiveTaskSite)')",
                            "table": "@parameters('Executive Working Y2026 Document Library (tms_ExecutiveWorkingY2026DocumentLibrary)')",
                            "folderPath": "@outputs('Update_file_properties_-_ID_Task_Lookup_Column_-_CEO_Task')?['body/{FullPath}']"
                          },
                          "host": {
                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                            "operationId": "GetFileItems",
                            "connectionName": "shared_sharepointonline-1"
                          }
                        }
                      },
                      "For_each_3": {
                        "foreach": "@outputs('Get_files_(properties_only)_-_All_Files_in_Folder_-_CEO_Task')?['body/value']",
                        "actions": {
                          "Send_an_HTTP_request_to_SharePoint_Rename_All_Files_-_CEO_Task": {
                            "type": "OpenApiConnection",
                            "inputs": {
                              "parameters": {
                                "dataset": "@parameters('Executive Task Site (tms_ExecutiveTaskSite)')",
