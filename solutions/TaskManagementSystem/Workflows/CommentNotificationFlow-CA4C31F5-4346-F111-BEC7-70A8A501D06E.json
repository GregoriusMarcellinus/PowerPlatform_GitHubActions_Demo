    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "Task Management Site (tms_TaskManagementSite)": {
          "defaultValue": "https://m365b467805.sharepoint.com/sites/TaskManagement",
          "type": "String",
          "metadata": {
            "schemaName": "tms_TaskManagementSite"
          }
        },
        "Task List (tms_TaskList)": {
          "defaultValue": "2b09fc89-2c29-499b-bca9-cd2d764eaf3a",
          "type": "String",
          "metadata": {
            "schemaName": "tms_TaskList"
          }
        },
        "Comment List (tms_CommentList)": {
          "defaultValue": "2b2af842-5948-4f79-9851-52c7c4b07c94",
          "type": "String",
          "metadata": {
            "schemaName": "tms_CommentList"
          }
        },
        "Task Assigned To Division List (tms_TaskAssignedToDivisionList)": {
          "defaultValue": "e59fc654-0a6c-469d-9edb-10b069db7077",
          "type": "String",
          "metadata": {
            "schemaName": "tms_TaskAssignedToDivisionList"
          }
        },
        "Task Assigned To Person List (tms_TaskAssignedToPersonList)": {
          "defaultValue": "14f77253-8e43-4f56-9f1e-6e6b0ba1fb23",
          "type": "String",
          "metadata": {
            "schemaName": "tms_TaskAssignedToPersonList"
          }
        },
        "User List (tms_UserList)": {
          "defaultValue": "b0e71eeb-dcac-48d0-81f5-e6fe08e70a16",
          "type": "String",
          "metadata": {
